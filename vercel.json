{
  "crons": [
    {
      "path": "/api/sync-marketing-optins",
      "schedule": "0 10 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/inclusao-moto",
      "destination": "/inclusao-moto/index.html"
    },
    {
      "source": "/inclusao-moto/",
      "destination": "/inclusao-moto/index.html"
    },
    {
      "source": "/((?!api/|assets/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
