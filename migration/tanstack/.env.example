# Endpoint HTTPS que recebe e persiste os opt-ins (Google Apps Script, webhook próprio ou outro backend).
MARKETING_OPTIN_WEBHOOK_URL=
# Opcional: segredo compartilhado enviado no header X-Aptos-Webhook-Secret.
MARKETING_OPTIN_WEBHOOK_SECRET=

# Alternativa integrada: ao conectar o store aptos-marketing-optins na Vercel,
# BLOB_READ_WRITE_TOKEN é criado automaticamente e o webhook deixa de ser necessário.
